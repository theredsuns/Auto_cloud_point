<?xml version="1.0" encoding="UTF-8" ?>
<!-- Force remote ROS 2 discovery/data onto the physical Ethernet interface. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>agx_eth0_udp</transport_id>
      <type>UDPv4</type>
      <interfaceWhiteList>
        <address>192.168.50.55</address>
        <address>127.0.0.1</address>
      </interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="agx_eth0_participant" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>agx_eth0_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
      <builtin>
        <initialPeersList>
          <locator>
            <udpv4><address>192.168.50.169</address><port>7400</port></udpv4>
          </locator>
        </initialPeersList>
      </builtin>
    </rtps>
  </participant>
</profiles>
